{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rdeskapp",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  // 纯静态站：python3 build.py 生成 dist/，然后 npx wrangler deploy
  "assets": { "directory": "dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "rdeskapp.com", "custom_domain": true },
    { "pattern": "www.rdeskapp.com", "custom_domain": true }
  ]
}
